# --- Database ---
# SQLite — just a local file, created automatically on first run. No server needed.
DATABASE_URL=sqlite:///./kt_dashboard.db

# --- Vector store ---
# ChromaDB — persists to a local folder, created automatically on first run. No server needed.
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=chunks

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# If your machine is low on RAM, pull and use phi3.5 instead

# --- App ---
SECRET_KEY=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:3000
