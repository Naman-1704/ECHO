# --- Database ---
# SQLite — just a local file, created automatically on first run. No server needed.
DATABASE_URL=

# --- Vector store ---
# ChromaDB — persists to a local folder, created automatically on first run. No server needed.
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION_NAME=

# --- Google OAuth ---
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET= 
GOOGLE_REDIRECT_URI=

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# If your machine is low on RAM, pull and use phi3.5 instead

# --- App ---
SECRET_KEY=
FRONTEND_URL=
